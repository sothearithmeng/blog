# Example env vars for a production deployment. Copy to .env and fill in real values —
# do not commit the filled-in file. Not read directly by Spring Boot — export these as
# real environment variables (or pass as JVM/Docker/K8s secrets) before running the app.
#
# prod fails fast at startup if any required (no-default) value below is missing.

SPRING_PROFILES_ACTIVE=prod

# Required: no defaults in prod.
DB_URL=jdbc:postgresql://your-host:5432/your-db
DB_USERNAME=your-user
DB_PASSWORD=your-password

# Optional: Hikari connection pool sizing (defaults: 10 / 5).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Required, comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=false

# Optional: base path/name for rotating log files (defaults to logs/blog).
LOG_FILE=/var/log/blog/app
