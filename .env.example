# Full reference of every env var the app reads, dev and prod combined. For a ready-to-copy
# starting point for one environment, use .env.dev.example or .env.prod.example instead.
#
# Copy this file to .env and adjust values as needed. Not read directly by Spring Boot —
# export these as real environment variables (or pass as JVM/Docker args) before running the app.

# Which profile to activate. Defaults to "dev" if unset (see application.yml).
# Use "prod" in production deployments.
SPRING_PROFILES_ACTIVE=dev

# Database connection. In dev these fall back to a local Postgres instance
# (jdbc:postgresql://localhost:5432/postgres / postgres / postgres) if left unset.
# In prod they are required — startup fails fast without them.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Prod-only: Hikari connection pool sizing (defaults: 10 / 5).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Prod-only, required: comma-separated list of allowed CORS origins, no wildcard.
# e.g. CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Optional: base path/name for rotating log files (defaults to logs/blog, or
# logs/blog-dev under the dev profile). e.g. /var/log/blog/app
LOG_FILE=logs/blog
