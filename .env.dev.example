# Example env vars for local development. Copy to .env and adjust values as needed.
# Not read directly by Spring Boot — export these as real environment variables
# (or pass as JVM/Docker args) before running the app.
#
# Everything below is optional in dev: application.yml / application-dev.yml already
# provide sensible local defaults, so you only need to set what differs from them.

SPRING_PROFILES_ACTIVE=dev

# Falls back to a local Postgres instance (postgres/postgres on localhost:5432) if unset.
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Optional: base path/name for rotating log files (defaults to logs/blog-dev).
LOG_FILE=logs/blog-dev
